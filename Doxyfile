# C0 public C, C ABI, and C++ documentation configuration.
# scripts/build-docs.sh supplies an isolated OUTPUT_DIRECTORY when it runs.

PROJECT_NAME           = "Beeb 6502 Core"
PROJECT_BRIEF          = "The deterministic 6502 and BBC Micro core"
OUTPUT_DIRECTORY       = .build/docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

# Only explicitly documented public declarations belong in the reference.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
# Private/internal named abstractions are enforced branch-wise by
# scripts/build-docs.sh; Doxygen output remains the supported public reference.
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INPUT                  = Sources/BeebCore/include \
                         Sources/BeebCore/src
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.c \
                         *.cpp \
                         *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */module.modulemap
INPUT_ENCODING         = UTF-8

# Markdown guides are added to INPUT by the documentation builder once present.
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES

# Documentation defects are build defects.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

# Keep generated pages navigable back to the implementation.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = cpp
GENERATE_TREEVIEW      = YES
# Keep the documentation build portable and deterministic. Relationship
# diagrams can be enabled later with an explicit Graphviz toolchain contract.
HAVE_DOT               = NO
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES
